@using FlightPlanner.Application.Dtos
@model IReadOnlyList<FlightDto>

@{
    ViewData["Title"] = "Flights";
}

<h1>Flights</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">New Flight</a>
</p>

@if (!Model.Any())
{
    <p>No flights have been entered yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Departure</th>
                <th>Destination</th>
                <th>Aircraft</th>
                <th>Distance (km)</th>
                <th>Flight time (h)</th>
                <th>Fuel (kg)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.DepartureAirport.IataCode &mdash; @flight.DepartureAirport.Name</td>
                    <td>@flight.DestinationAirport.IataCode &mdash; @flight.DestinationAirport.Name</td>
                    <td>@flight.Aircraft.Name</td>
                    <td>@flight.DistanceKm.ToString("N0")</td>
                    <td>@flight.EstimatedFlightTimeHours.ToString("N1")</td>
                    <td>@flight.EstimatedFuelKg.ToString("N0")</td>
                    <td><a asp-action="Edit" asp-route-id="@flight.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
}
